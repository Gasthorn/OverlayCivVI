/* Thème sombre de l'overlay (spec 03 §3.1). */

QWidget {
    color: #e6e6e6;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QFrame#root {
    background-color: rgb(20, 22, 28);
    border: 1px solid rgb(60, 64, 76);
    border-radius: 8px;
}

QFrame#root[interactive="true"] {
    border: 1px solid rgb(212, 175, 55);
}

QLabel#status {
    color: #9aa0ac;
    font-style: italic;
}

QFrame#panel {
    border-top: 1px solid rgb(48, 52, 62);
}

QFrame#pages {
    border-top: 1px solid rgb(48, 52, 62);
}

QPushButton#panelHeader {
    background: transparent;
    border: none;
    color: #d4af37;
    font-weight: 600;
    text-align: left;
    padding: 2px 0;
}

QLabel#actionIcon   { font-family: "Segoe UI Emoji"; font-size: 11pt; }
QLabel#actionTitle      { color: #f5f5f5; font-weight: 600; }
QLabel#actionTitleFocus { color: #f2d36b; font-weight: 600; }  /* sert la stratégie suivie */
QLabel#actionReason     { color: #9aa0ac; font-size: 9pt; }

QLabel#strategyName         { color: #f5f5f5; font-weight: 600; }
QLabel#strategyNameFollowed { color: #f2d36b; font-weight: 700; }

/* Onglets des pages (spec 03 §4). */
QPushButton#pageTab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #8a909c;
    font-weight: 600;
    padding: 2px 6px;
}

QPushButton#pageTab:checked {
    color: #d4af37;
    border-bottom: 2px solid #d4af37;
}

QLabel#sectionTitle {
    color: #d4af37;
    font-weight: 600;
    padding-top: 4px;
}

/* Page Villes (spec 03 §4.4). */
QComboBox#cityCombo, QComboBox#layoutLimit {
    background-color: rgb(36, 39, 48);
    border: 1px solid rgb(70, 75, 88);
    border-radius: 4px;
    padding: 2px 6px;
}

QComboBox#cityCombo QAbstractItemView, QComboBox#layoutLimit QAbstractItemView {
    background-color: rgb(28, 31, 39);
    selection-background-color: rgb(60, 64, 76);
}

QLabel#layoutNow   { color: #f2d36b; font-weight: 600; }
QLabel#layoutLater { color: #8a909c; }
QLabel#layoutBuilt { color: #f5f5f5; }
QLabel#legendTitle { color: #c8ccd4; font-size: 9pt; font-weight: 600; }
QLabel#followedHeader { color: #f2d36b; font-weight: 700; font-size: 11pt; }
QLabel#prompt         { color: #e6e6e6; font-style: italic; padding-bottom: 2px; }

QPushButton#linkButton {
    background: transparent;
    border: none;
    color: #6fb7ff;
    padding: 0 2px;
}

QFrame#strategyCard,
QFrame#strategyCardFollowed {
    background-color: rgb(28, 31, 39);
    border: 1px solid rgb(48, 52, 62);
    border-radius: 5px;
}

QFrame#strategyCardFollowed {
    border: 1px solid #d4af37;
}

QPushButton#followButton,
QPushButton#followButtonActive {
    background-color: rgb(40, 44, 54);
    border: 1px solid rgb(70, 75, 88);
    border-radius: 4px;
    color: #e6e6e6;
    padding: 1px 8px;
}

QPushButton#followButton:hover { border-color: #d4af37; color: #f2d36b; }
QPushButton#followButtonActive { border-color: #d4af37; color: #f2d36b; font-weight: 600; }

QProgressBar#strategyBar {
    background-color: rgb(36, 39, 48);
    border: 1px solid rgb(60, 64, 76);
    border-radius: 4px;
    color: #f5f5f5;
    font-size: 8pt;
    max-height: 12px;
    text-align: center;
}

QProgressBar#strategyBar::chunk {
    background-color: rgb(212, 175, 55);
    border-radius: 3px;
}

QPushButton#moreActions {
    background: transparent;
    border: none;
    color: #6fb7ff;
    padding: 2px 0;
}

/* Données périmées (spec 03 §3.3) : propriété posée sur la racine. Les pseudo-états
   (:disabled) sur un ancêtre sont mal évalués par Qt et grisaient tout en permanence. */
QFrame#root[stale="true"] QLabel {
    color: #5c6170;
}

QPushButton#close {
    background: transparent;
    border: none;
    color: #9aa0ac;
    font-size: 13pt;
    padding: 0 4px;
}

QPushButton#close:hover {
    color: #ff6b6b;
}
